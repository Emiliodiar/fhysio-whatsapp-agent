# ============================================================
#  WhatsApp AI Agent Kit — variables de entorno
#  Copia este archivo a .env.local y rellena los valores.
#  (.env.local NUNCA se sube a git — está en .gitignore)
# ============================================================

# --- OBLIGATORIA ---
# API key de OpenRouter (formato sk-or-v1-...).
# El agente la usa para hablar con el modelo de IA.
# El bot ABORTA al arrancar si falta o está vacía.
# Consíguela gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Modelo de IA (tiene default: openai/gpt-4o-mini) ---
# Recomendados (buena relación calidad/precio):
#   openai/gpt-4o-mini
#   anthropic/claude-haiku-4-5
#   google/gemini-2.5-flash
# IMPORTANTE: NUNCA uses modelos terminados en :free
#   (están saturados y devuelven 429 en producción).
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Tool "guardarLead" (opcional) ---
# Webhook de Google Apps Script para guardar leads en una hoja de cálculo.
# Si lo dejas vacío, la tool guardarLead queda inactiva (devuelve ok:false).
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Tool "agendar" (opcional) ---
# URL de Cal.com o Calendly para agendar llamadas.
# Ejemplo: https://cal.com/tu-usuario/diagnostico
# Si lo dejas vacío, la tool agendar queda inactiva.
# La escribe /personaliza si eliges Cal.com.
CAL_BOOKING_URL=

# --- Producción (opcionales) ---
# Puerto del panel web Next.js. Default 3000.
PORT=3000

# Nivel de log del bot: silent | error | warn | info | debug. Default info.
# (El logger interno de Baileys va siempre en silent, aparte de este.)
LOG_LEVEL=info
